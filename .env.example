# ==== Supabase ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==== Sessão (OBRIGATÓRIO) ====
# Assina o cookie de sessão (HMAC). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sem isto o login não funciona (fail-closed proposital).
SESSION_SECRET=

# ==== Cron / automações (OBRIGATÓRIO em produção) ====
# Protege /api/cron/reminders. Sem isto o endpoint é recusado (fail-closed).
CRON_SECRET=

# ==== Web Push (VAPID) ====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==== IA — OpenAI ====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ==== URL pública do app ====
NEXT_PUBLIC_APP_URL=

# ==== Google Agenda + login com Google ====
# Credenciais do OAuth 2.0 (Google Cloud Console → APIs e serviços → Credenciais
# → ID do cliente OAuth → Aplicativo da Web). Passo a passo: docs/google-agenda.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: por padrão vira NEXT_PUBLIC_APP_URL + /api/google/callback.
# Se preencher, precisa ser IDÊNTICA à cadastrada em "URIs de redirecionamento".
GOOGLE_REDIRECT_URI=

# ==== Rate limit distribuído (opcional, recomendado) — Upstash Redis ====
# Sem isto, o limite roda em memória (best-effort). Crie um banco grátis em upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==== Captcha no agendamento público (opcional, recomendado) — Cloudflare Turnstile ====
# Crie grátis em dash.cloudflare.com → Turnstile. Sem as chaves, o captcha fica desligado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Token interno para o bot/assistente pularem o captcha ao agendar. Defina QUALQUER
# string aleatória QUANDO ativar o Turnstile (senão o bot do WhatsApp para de agendar).
INTERNAL_BOOKING_TOKEN=

# ==== Diagnóstico do bot (opcional) ====
# BOT_DEBUG=1 grava os estágios de processamento no banco (use só ao investigar).
BOT_DEBUG=

# ==== Hubla (pagamentos) — OBRIGATÓRIO para liberar planos automaticamente ====
# Autentica o webhook /api/webhooks/hubla. Sem isto o endpoint recusa tudo (503).
# Onde achar: app.hub.la → Integrações → Webhook → aba Autenticação →
# "Hubla Webhook Token". Copie exatamente, sem espaços.
HUBLA_WEBHOOK_TOKEN=

# ==== E-mail transacional (Resend) ====
# Liga os e-mails: boas-vindas do cadastro, assinatura confirmada, pagamento
# falhou, assinatura encerrada — e os avisos do admin (link de senha, link
# mágico, mudança de e-mail). Sem a chave, tudo é pulado silenciosamente.
# Chave em resend.com/api-keys (permissão de envio basta).
RESEND_API_KEY=
# Remetente. O domínio precisa estar VERIFICADO no Resend, senão o envio é recusado.
MAIL_FROM="Lume <nao-responda@lumepage.com.br>"
# Para onde vai a resposta de quem responde o e-mail (opcional).
MAIL_REPLY_TO=

# ==== WhatsApp (uazapi) — provisionamento automático ====
# Com estas duas, o Lume cria a instância da profissional sozinho no primeiro
# clique em "Conectar WhatsApp" (ela nunca vê URL nem token). Sem elas, o painel
# volta a pedir URL e token na mão.
# O admintoken é do SERVIDOR (cria/apaga qualquer instância) — trate como senha.
UAZAPI_SERVER_URL=
UAZAPI_ADMIN_TOKEN=
