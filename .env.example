# ==== Supabase ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==== Sessão (OBRIGATÓRIO) ====
# Assina o cookie de sessão (HMAC). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sem isto o login não funciona (fail-closed proposital).
SESSION_SECRET=

# ==== Cron / automações (OBRIGATÓRIO em produção) ====
# Protege /api/cron/reminders. Sem isto o endpoint é recusado (fail-closed).
CRON_SECRET=

# ==== Web Push (VAPID) ====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==== IA — OpenAI ====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ==== URL pública do app ====
NEXT_PUBLIC_APP_URL=
