# ==== Supabase ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==== Sessão (OBRIGATÓRIO) ====
# Assina o cookie de sessão (HMAC). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sem isto o login não funciona (fail-closed proposital).
SESSION_SECRET=

# ==== Cron / automações (OBRIGATÓRIO em produção) ====
# Protege /api/cron/reminders. Sem isto o endpoint é recusado (fail-closed).
CRON_SECRET=

# ==== Web Push (VAPID) ====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==== IA — OpenAI ====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ==== URL pública do app ====
NEXT_PUBLIC_APP_URL=

# ==== Rate limit distribuído (opcional, recomendado) — Upstash Redis ====
# Sem isto, o limite roda em memória (best-effort). Crie um banco grátis em upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==== Captcha no agendamento público (opcional, recomendado) — Cloudflare Turnstile ====
# Crie grátis em dash.cloudflare.com → Turnstile. Sem as chaves, o captcha fica desligado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Token interno para o bot/assistente pularem o captcha ao agendar. Defina QUALQUER
# string aleatória QUANDO ativar o Turnstile (senão o bot do WhatsApp para de agendar).
INTERNAL_BOOKING_TOKEN=

# ==== Diagnóstico do bot (opcional) ====
# BOT_DEBUG=1 grava os estágios de processamento no banco (use só ao investigar).
BOT_DEBUG=

# ==== Hubla (pagamentos) — OBRIGATÓRIO para liberar planos automaticamente ====
# Autentica o webhook /api/webhooks/hubla. Sem isto o endpoint recusa tudo (503).
# Onde achar: app.hub.la → Integrações → Webhook → aba Autenticação →
# "Hubla Webhook Token". Copie exatamente, sem espaços.
HUBLA_WEBHOOK_TOKEN=
